# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=
DEFAULT_ALERT_CHANNEL_ID=
DIGEST_CHANNEL_ID=
# Danh sách Discord user ID được dùng lệnh ghi, phân tách bằng dấu phẩy
ADMIN_USER_IDS=

# Lưu trữ
DB_PATH=./data/monitor.db

# Hành vi
DIGEST_HOUR_LOCAL=9
DEFAULT_INTERVAL_SECONDS=60
DEFAULT_TIMEOUT_MS=10000
DEFAULT_LATENCY_THRESHOLD_MS=2000
CHECK_RETENTION_DAYS=30
MAX_CONCURRENT_CHECKS=5
TICK_INTERVAL_MS=10000
LOG_LEVEL=info

# Messenger (tắt mặc định; bật thì 3 biến secret là bắt buộc)
MESSENGER_ENABLED=false
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PORT=8080
MESSENGER_WEBHOOK_PATH=/webhook/messenger
MESSENGER_API_VERSION=v21.0
MESSENGER_OUTBOX_MAX_AGE_HOURS=48
